Dialogue: 0,0:23:07.07,0:23:07.74,ED_JP,,0,0,0,,{\c&HFFFFFF&}UNHAPPY？
Dialogue: 0,0:23:07.74,0:23:08.91,ED_JP,,0,0,0,,{\c&HFFFFFF&}悩める人の子よ
Dialogue: 0,0:23:08.91,0:23:09.37,ED_JP,,0,0,0,,{\c&HFFFFFF&}UNLUCKY？
Dialogue: 0,0:23:09.37,0:23:10.45,ED_JP,,0,0,0,,{\c&HFFFFFF&}人成らざる者も
Dialogue: 0,0:23:10.45,0:23:11.08,ED_JP,,0,0,0,,{\c&HFFFFFF&}BE HAPPY！
Dialogue: 0,0:23:11.08,0:23:12.29,ED_JP,,0,0,0,,{\c&HFFFFFF&}弛まず目指せよ
Dialogue: 0,0:23:12.29,0:23:13.70,ED_JP,,0,0,0,,{\c&HFFFFFF&}生きているんだし
Dialogue: 0,0:23:13.70,0:23:15.42,ED_JP,,0,0,0,,{\c&HFFFFFF&}目を逸らした過去も
Dialogue: 0,0:23:15.42,0:23:17.08,ED_JP,,0,0,0,,{\c&HFFFFFF&}退屈な未来も
Dialogue: 0,0:23:17.08,0:23:17.96,ED_JP,,0,0,0,,{\c&HFFFFFF&}カウンセリング
Dialogue: 0,0:23:17.96,0:23:19.00,ED_JP,,0,0,0,,{\c&HFFFFFF&}やれやれ
Dialogue: 0,0:23:19.00,0:23:19.71,ED_JP,,0,0,0,,{\c&HFFFFFF&}古今東西
Dialogue: 0,0:23:19.71,0:23:20.46,ED_JP,,0,0,0,,{\c&HFFFFFF&}ピースピース
Dialogue: 0,0:23:20.46,0:23:21.21,ED_JP,,0,0,0,,{\c&HFFFFFF&}UNHAPPY？
Dialogue: 0,0:23:22.05,0:23:22.92,ED_JP,,0,0,0,,{\c&HFFFFFF&}UNLUCKY？
Dialogue: 0,0:23:23.71,0:23:24.76,ED_JP,,0,0,0,,{\c&HFFFFFF&}BE HAPPY！
Dialogue: 0,0:23:25.38,0:23:26.38,ED_JP,,0,0,0,,{\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:23:33.35,0:23:34.39,ED_JP,,0,0,0,,{\c&HFFFFFF&}カットイン
Dialogue: 0,0:23:34.39,0:23:35.48,ED_JP,,0,0,0,,{\c&HFFFFFF&}何だかどうして
Dialogue: 0,0:23:35.48,0:23:36.89,ED_JP,,0,0,0,,{\c&HFFFFFF&}未来になんぞ
Dialogue: 0,0:23:36.89,0:23:38.81,ED_JP,,0,0,0,,{\c&HFFFFFF&}何の希望もない期待出来ない
Dialogue: 0,0:23:38.81,0:23:40.65,ED_JP,,0,0,0,,{\c&HFFFFFF&}ような気がして
Dialogue: 0,0:23:40.65,0:23:42.11,ED_JP,,0,0,0,,{\c&HFFFFFF&}もう随分生きている
Dialogue: 0,0:23:42.11,0:23:43.73,ED_JP,,0,0,0,,{\c&HFFFFFF&}既視感とテンプレで食傷
Dialogue: 0,0:23:43.73,0:23:46.82,ED_JP,,0,0,0,,{\c&HFFFFFF&}素敵な出来事の気配もない
Dialogue: 0,0:23:46.82,0:23:47.78,ED_JP,,0,0,0,,{\c&HFFFFFF&}残念
Dialogue: 0,0:23:47.78,0:23:48.91,ED_JP,,0,0,0,,{\c&HFFFFFF&}積んだ経験の因果
Dialogue: 0,0:23:48.91,0:23:51.12,ED_JP,,0,0,0,,{\c&HFFFFFF&}形骸化された神話と退屈な進化
Dialogue: 0,0:23:51.12,0:23:52.37,ED_JP,,0,0,0,,{\c&HFFFFFF&}要は刺激が欲しいんだ
Dialogue: 0,0:23:52.37,0:23:52.99,ED_JP,,0,0,0,,{\c&HFFFFFF&}飽きちゃった
Dialogue: 0,0:23:52.99,0:23:53.62,ED_JP,,0,0,0,,{\c&HFFFFFF&}慣れちゃった
Dialogue: 0,0:23:53.62,0:23:54.25,ED_JP,,0,0,0,,{\c&HFFFFFF&}なんて
Dialogue: 0,0:23:54.25,0:23:55.87,ED_JP,,0,0,0,,{\c&HFFFFFF&}整っていくガイダンス
Dialogue: 0,0:23:55.87,0:23:57.37,ED_JP,,0,0,0,,{\c&HFFFFFF&}増えるコンプライアンス
Dialogue: 0,0:23:57.37,0:23:59.33,ED_JP,,0,0,0,,{\c&HFFFFFF&}蓋されていくみたい
Dialogue: 0,0:23:59.33,0:24:00.96,ED_JP,,0,0,0,,{\c&HFFFFFF&}吸い尽くして
Dialogue: 0,0:24:00.96,0:24:03.34,ED_JP,,0,0,0,,{\c&HFFFFFF&}あれもこれもどれも
Dialogue: 0,0:24:03.34,0:24:05.63,ED_JP,,0,0,0,,{\c&HFFFFFF&}同じ味がする
Dialogue: 0,0:24:05.84,0:24:06.34,ED_JP,,0,0,0,,{\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:24:06.34,0:24:07.72,ED_JP,,0,0,0,,{\c&HFFFFFF&}死んじゃいない
Dialogue: 0,0:24:07.72,0:24:09.59,ED_JP,,0,0,0,,{\c&HFFFFFF&}お前とお前の連鎖
Dialogue: 0,0:24:09.59,0:24:13.64,ED_JP,,0,0,0,,{\c&HFFFFFF&}生きていることとは変わり続けることだ
Dialogue: 0,0:24:13.64,0:24:15.43,ED_JP,,0,0,0,,{\c&HFFFFFF&}不幸に甘んじて
Dialogue: 0,0:24:15.43,0:24:16.98,ED_JP,,0,0,0,,{\c&HFFFFFF&}満足するなよ
Dialogue: 0,0:24:16.98,0:24:20.81,ED_JP,,0,0,0,,{\c&HFFFFFF&}幸せになろうとしないなんて卑怯だ
Dialogue: 0,0:24:20.81,0:24:22.27,ED_JP,,0,0,0,,{\c&HFFFFFF&}この世この世は
Dialogue: 0,0:24:22.27,0:24:23.73,ED_JP,,0,0,0,,{\c&HFFFFFF&}奇怪奇怪ファンタジー
Dialogue: 0,0:24:23.73,0:24:26.86,ED_JP,,0,0,0,,{\c&HFFFFFF&}次は鬼が出るか蛇が出るか
Dialogue: 0,0:24:26.86,0:24:30.32,ED_JP,,0,0,0,,{\c&HFFFFFF&}出会って遭ってやっと始まる物語
Dialogue: 0,0:24:30.32,0:24:32.33,ED_JP,,0,0,0,,{\c&HFFFFFF&}さあ人か化物か
Dialogue: 0,0:24:32.33,0:24:33.03,ED_JP,,0,0,0,,{\c&HFFFFFF&}閑話休題
Dialogue: 0,0:24:33.03,0:24:33.83,ED_JP,,0,0,0,,{\c&HFFFFFF&}ピースピース
Comment: 0,0:23:07.07,0:23:07.74,ED_CN,,0,0,0,,{\c&HFFFFFF&}UNHAPPY？
Dialogue: 0,0:23:07.74,0:23:08.91,ED_CN,,0,0,0,,{\c&HFFFFFF&}苦惱的人們
Comment: 0,0:23:08.91,0:23:09.37,ED_CN,,0,0,0,,{\c&HFFFFFF&}UNLUCKY？
Dialogue: 0,0:23:09.37,0:23:10.45,ED_CN,,0,0,0,,{\c&HFFFFFF&}非人的傢伙們
Comment: 0,0:23:10.45,0:23:11.08,ED_CN,,0,0,0,,{\c&HFFFFFF&}BE HAPPY！
Dialogue: 0,0:23:11.08,0:23:12.29,ED_CN,,0,0,0,,{\c&HFFFFFF&}不要懈怠向前吧
Dialogue: 0,0:23:12.29,0:23:13.70,ED_CN,,0,0,0,,{\c&HFFFFFF&}畢竟還活著
Dialogue: 0,0:23:13.70,0:23:15.42,ED_CN,,0,0,0,,{\c&HFFFFFF&}無論是迴避的過去
Dialogue: 0,0:23:15.42,0:23:17.08,ED_CN,,0,0,0,,{\c&HFFFFFF&}還是無聊的未來
Dialogue: 0,0:23:17.08,0:23:17.96,ED_CN,,0,0,0,,{\c&HFFFFFF&}COUNSELING
Dialogue: 0,0:23:17.96,0:23:19.00,ED_CN,,0,0,0,,{\c&HFFFFFF&}真是的
Dialogue: 0,0:23:19.00,0:23:19.71,ED_CN,,0,0,0,,{\c&HFFFFFF&}古今中外
Dialogue: 0,0:23:19.71,0:23:20.46,ED_CN,,0,0,0,,{\c&HFFFFFF&}PEACE PEACE
Comment: 0,0:23:20.46,0:23:21.21,ED_CN,,0,0,0,,{\c&HFFFFFF&}UNHAPPY？
Comment: 0,0:23:22.05,0:23:22.92,ED_CN,,0,0,0,,{\c&HFFFFFF&}UNLUCKY？
Comment: 0,0:23:23.71,0:23:24.76,ED_CN,,0,0,0,,{\c&HFFFFFF&}BE HAPPY！
Comment: 0,0:23:25.38,0:23:26.38,ED_CN,,0,0,0,,{\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:23:33.35,0:23:34.39,ED_CN,,0,0,0,,{\c&HFFFFFF&}CUT IN
Dialogue: 0,0:23:34.39,0:23:35.48,ED_CN,,0,0,0,,{\c&HFFFFFF&}為甚麼如此呢
Dialogue: 0,0:23:35.48,0:23:36.89,ED_CN,,0,0,0,,{\c&HFFFFFF&}對於所謂的未來
Dialogue: 0,0:23:36.89,0:23:38.81,ED_CN,,0,0,0,,{\c&HFFFFFF&}難抱任何希望也難有期待
Dialogue: 0,0:23:38.81,0:23:40.65,ED_CN,,0,0,0,,{\c&HFFFFFF&}總有這種感覺
Dialogue: 0,0:23:40.65,0:23:42.11,ED_CN,,0,0,0,,{\c&HFFFFFF&}已經活了這麼久
Dialogue: 0,0:23:42.11,0:23:43.73,ED_CN,,0,0,0,,{\c&HFFFFFF&}既視感和模板化使人厭倦
Dialogue: 0,0:23:43.73,0:23:46.82,ED_CN,,0,0,0,,{\c&HFFFFFF&}毫無美好事情的跡象
Dialogue: 0,0:23:46.82,0:23:47.78,ED_CN,,0,0,0,,{\c&HFFFFFF&}遺憾
Dialogue: 0,0:23:47.78,0:23:48.91,ED_CN,,0,0,0,,{\c&HFFFFFF&}積累過經驗的因果
Dialogue: 0,0:23:48.91,0:23:51.12,ED_CN,,0,0,0,,{\c&HFFFFFF&}形式化的神話與乏味的進化
Dialogue: 0,0:23:51.12,0:23:52.37,ED_CN,,0,0,0,,{\c&HFFFFFF&}就是想要刺激
Dialogue: 0,0:23:52.37,0:23:52.99,ED_CN,,0,0,0,,{\c&HFFFFFF&}受夠了
Dialogue: 0,0:23:52.99,0:23:53.62,ED_CN,,0,0,0,,{\c&HFFFFFF&}習慣了
Dialogue: 0,0:23:53.62,0:23:54.25,ED_CN,,0,0,0,,{\c&HFFFFFF&}這樣的
Dialogue: 0,0:23:54.25,0:23:55.87,ED_CN,,0,0,0,,{\c&HFFFFFF&}越發完善的指引
Dialogue: 0,0:23:55.87,0:23:57.37,ED_CN,,0,0,0,,{\c&HFFFFFF&}增多的規範
Dialogue: 0,0:23:57.37,0:23:59.33,ED_CN,,0,0,0,,{\c&HFFFFFF&}像要封閉一般
Dialogue: 0,0:23:59.33,0:24:00.96,ED_CN,,0,0,0,,{\c&HFFFFFF&}吸盡所有
Dialogue: 0,0:24:00.96,0:24:03.34,ED_CN,,0,0,0,,{\c&HFFFFFF&}這一切的一切
Dialogue: 0,0:24:03.34,0:24:05.63,ED_CN,,0,0,0,,{\c&HFFFFFF&}都是相同的味道
Comment: 0,0:24:05.84,0:24:06.34,ED_CN,,0,0,0,,{\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:24:06.34,0:24:07.72,ED_CN,,0,0,0,,{\c&HFFFFFF&}沒有死去
Dialogue: 0,0:24:07.72,0:24:09.59,ED_CN,,0,0,0,,{\c&HFFFFFF&}你與你的連鎖
Dialogue: 0,0:24:09.59,0:24:13.64,ED_CN,,0,0,0,,{\c&HFFFFFF&}活著便是不斷改變
Dialogue: 0,0:24:13.64,0:24:15.43,ED_CN,,0,0,0,,{\c&HFFFFFF&}不要沉溺於不幸中
Dialogue: 0,0:24:15.43,0:24:16.98,ED_CN,,0,0,0,,{\c&HFFFFFF&}不要滿足
Dialogue: 0,0:24:16.98,0:24:20.81,ED_CN,,0,0,0,,{\c&HFFFFFF&}不去追求幸福便是懦弱
Dialogue: 0,0:24:20.81,0:24:22.27,ED_CN,,0,0,0,,{\c&HFFFFFF&}這個世界之中
Dialogue: 0,0:24:22.27,0:24:23.73,ED_CN,,0,0,0,,{\c&HFFFFFF&}千奇百怪的幻想
Dialogue: 0,0:24:23.73,0:24:26.86,ED_CN,,0,0,0,,{\c&HFFFFFF&}今後的發展難以預料
Dialogue: 0,0:24:26.86,0:24:30.32,ED_CN,,0,0,0,,{\c&HFFFFFF&}相遇後終於開始的故事
Dialogue: 0,0:24:30.32,0:24:32.33,ED_CN,,0,0,0,,{\c&HFFFFFF&}是人還是怪物
Dialogue: 0,0:24:32.33,0:24:33.03,ED_CN,,0,0,0,,{\c&HFFFFFF&}莫提閒話
Dialogue: 0,0:24:33.03,0:24:33.83,ED_CN,,0,0,0,,{\c&HFFFFFF&}PEACE PEACE
Comment: 0,0:24:26.78,0:24:28.78,Default,,0,0,0,,
