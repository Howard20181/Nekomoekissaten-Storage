Dialogue: 0,0:11:01.14,0:11:01.81,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}UNHAPPY？
Dialogue: 0,0:11:01.81,0:11:02.97,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}悩める人の子よ
Dialogue: 0,0:11:02.97,0:11:03.43,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}UNLUCKY？
Dialogue: 0,0:11:03.43,0:11:04.52,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}人成らざる者も
Dialogue: 0,0:11:04.52,0:11:05.14,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}BE HAPPY！
Dialogue: 0,0:11:05.14,0:11:06.35,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}弛まず目指せよ
Dialogue: 0,0:11:06.35,0:11:07.77,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}生きているんだし
Dialogue: 0,0:11:07.77,0:11:09.48,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}目を逸らした過去も
Dialogue: 0,0:11:09.48,0:11:11.15,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}退屈な未来も
Dialogue: 0,0:11:11.15,0:11:12.03,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}カウンセリング
Dialogue: 0,0:11:12.03,0:11:13.07,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}やれやれ
Dialogue: 0,0:11:13.07,0:11:13.78,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}古今東西
Dialogue: 0,0:11:13.78,0:11:14.53,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}ピースピース
Dialogue: 0,0:11:14.53,0:11:15.28,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}UNHAPPY？
Dialogue: 0,0:11:16.11,0:11:16.99,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}UNLUCKY？
Dialogue: 0,0:11:17.78,0:11:18.82,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}BE HAPPY！
Dialogue: 0,0:11:19.45,0:11:20.45,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:11:27.42,0:11:28.46,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}カットイン
Dialogue: 0,0:11:28.46,0:11:29.54,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}何だかどうして
Dialogue: 0,0:11:29.54,0:11:30.96,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}未来になんぞ
Dialogue: 0,0:11:30.96,0:11:32.88,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}何の希望もない期待出来ない
Dialogue: 0,0:11:32.88,0:11:34.72,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}ような気がして
Dialogue: 0,0:11:34.72,0:11:36.17,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}もう随分生きている
Dialogue: 0,0:11:36.17,0:11:37.80,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}既視感とテンプレで食傷
Dialogue: 0,0:11:37.80,0:11:40.89,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}素敵な出来事の気配もない
Dialogue: 0,0:11:40.89,0:11:41.85,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}残念
Dialogue: 0,0:11:41.85,0:11:42.97,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}積んだ経験の因果
Dialogue: 0,0:11:42.97,0:11:45.18,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}形骸化された神話と退屈な進化
Dialogue: 0,0:11:45.18,0:11:46.44,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}要は刺激が欲しいんだ
Dialogue: 0,0:11:46.44,0:11:47.06,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}飽きちゃった
Dialogue: 0,0:11:47.06,0:11:47.69,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}慣れちゃった
Dialogue: 0,0:11:47.69,0:11:48.31,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}なんて
Dialogue: 0,0:11:48.31,0:11:49.94,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}整っていくガイダンス
Dialogue: 0,0:11:49.94,0:11:51.44,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}増えるコンプライアンス
Dialogue: 0,0:11:51.44,0:11:53.40,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}蓋されていくみたい
Dialogue: 0,0:11:53.40,0:11:55.03,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}吸い尽くして
Dialogue: 0,0:11:55.03,0:11:57.40,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}あれもこれもどれも
Dialogue: 0,0:11:57.40,0:11:59.70,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}同じ味がする
Dialogue: 0,0:11:59.91,0:12:00.41,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:12:00.41,0:12:01.78,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}死んじゃいない
Dialogue: 0,0:12:01.78,0:12:03.66,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}お前とお前の連鎖
Dialogue: 0,0:12:03.66,0:12:07.71,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}生きていることとは変わり続けることだ
Dialogue: 0,0:12:07.71,0:12:09.50,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}不幸に甘んじて
Dialogue: 0,0:12:09.50,0:12:11.04,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}満足するなよ
Dialogue: 0,0:12:11.04,0:12:14.88,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}幸せになろうとしないなんて卑怯だ
Dialogue: 0,0:12:14.88,0:12:16.34,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}この世この世は
Dialogue: 0,0:12:16.34,0:12:17.80,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}奇怪奇怪ファンタジー
Dialogue: 0,0:12:17.80,0:12:20.93,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}次は鬼が出るか蛇が出るか
Dialogue: 0,0:12:20.93,0:12:24.39,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}出会って遭ってやっと始まる物語
Dialogue: 0,0:12:24.39,0:12:26.39,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}さあ人か化物か
Dialogue: 0,0:12:26.39,0:12:27.10,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}閑話休題
Dialogue: 0,0:12:27.10,0:12:27.89,ED_JP,,27,0,0,,{\an1\c&HFFFFFF&}ピースピース
Comment: 0,0:11:01.14,0:11:01.81,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}UNHAPPY？
Dialogue: 0,0:11:01.81,0:11:02.97,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}苦惱的人們
Comment: 0,0:11:02.97,0:11:03.43,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}UNLUCKY？
Dialogue: 0,0:11:03.43,0:11:04.52,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}非人的傢伙們
Comment: 0,0:11:04.52,0:11:05.14,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}BE HAPPY！
Dialogue: 0,0:11:05.14,0:11:06.35,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}不要懈怠向前吧
Dialogue: 0,0:11:06.35,0:11:07.77,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}畢竟還活著
Dialogue: 0,0:11:07.77,0:11:09.48,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}無論是迴避的過去
Dialogue: 0,0:11:09.48,0:11:11.15,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}還是無聊的未來
Dialogue: 0,0:11:11.15,0:11:12.03,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}COUNSELING
Dialogue: 0,0:11:12.03,0:11:13.07,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}真是的
Dialogue: 0,0:11:13.07,0:11:13.78,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}古今中外
Dialogue: 0,0:11:13.78,0:11:14.53,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}PEACE PEACE
Comment: 0,0:11:14.53,0:11:15.28,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}UNHAPPY？
Comment: 0,0:11:16.11,0:11:16.99,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}UNLUCKY？
Comment: 0,0:11:17.78,0:11:18.82,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}BE HAPPY！
Comment: 0,0:11:19.45,0:11:20.45,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:11:27.42,0:11:28.46,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}CUT IN
Dialogue: 0,0:11:28.46,0:11:29.54,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}為甚麼如此呢
Dialogue: 0,0:11:29.54,0:11:30.96,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}對於所謂的未來
Dialogue: 0,0:11:30.96,0:11:32.88,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}難抱任何希望也難有期待
Dialogue: 0,0:11:32.88,0:11:34.72,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}總有這種感覺
Dialogue: 0,0:11:34.72,0:11:36.17,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}已經活了這麼久
Dialogue: 0,0:11:36.17,0:11:37.80,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}既視感和模板化使人厭倦
Dialogue: 0,0:11:37.80,0:11:40.89,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}毫無美好事情的跡象
Dialogue: 0,0:11:40.89,0:11:41.85,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}遺憾
Dialogue: 0,0:11:41.85,0:11:42.97,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}積累過經驗的因果
Dialogue: 0,0:11:42.97,0:11:45.18,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}形式化的神話與乏味的進化
Dialogue: 0,0:11:45.18,0:11:46.44,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}就是想要刺激
Dialogue: 0,0:11:46.44,0:11:47.06,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}受夠了
Dialogue: 0,0:11:47.06,0:11:47.69,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}習慣了
Dialogue: 0,0:11:47.69,0:11:48.31,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}這樣的
Dialogue: 0,0:11:48.31,0:11:49.94,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}越發完善的指引
Dialogue: 0,0:11:49.94,0:11:51.44,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}增多的規範
Dialogue: 0,0:11:51.44,0:11:53.40,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}像要封閉一般
Dialogue: 0,0:11:53.40,0:11:55.03,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}吸盡所有
Dialogue: 0,0:11:55.03,0:11:57.40,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}這一切的一切
Dialogue: 0,0:11:57.40,0:11:59.70,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}都是相同的味道
Comment: 0,0:11:59.91,0:12:00.41,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}UNDEAD
Dialogue: 0,0:12:00.41,0:12:01.78,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}沒有死去
Dialogue: 0,0:12:01.78,0:12:03.66,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}你與你的連鎖
Dialogue: 0,0:12:03.66,0:12:07.71,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}活著便是不斷改變
Dialogue: 0,0:12:07.71,0:12:09.50,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}不要沉溺於不幸中
Dialogue: 0,0:12:09.50,0:12:11.04,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}不要滿足
Dialogue: 0,0:12:11.04,0:12:14.88,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}不去追求幸福便是懦弱
Dialogue: 0,0:12:14.88,0:12:16.34,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}這個世界之中
Dialogue: 0,0:12:16.34,0:12:17.80,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}千奇百怪的幻想
Dialogue: 0,0:12:17.80,0:12:20.93,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}今後的發展難以預料
Dialogue: 0,0:12:20.93,0:12:24.39,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}相遇後終於開始的故事
Dialogue: 0,0:12:24.39,0:12:26.39,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}是人還是怪物
Dialogue: 0,0:12:26.39,0:12:27.10,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}莫提閒話
Dialogue: 0,0:12:27.10,0:12:27.89,ED_CN,,0,24,0,,{\an9\c&HFFFFFF&}PEACE PEACE
Comment: 0,0:23:26.13,0:23:28.14,Default,,0,0,0,,
