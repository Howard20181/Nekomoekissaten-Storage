Dialogue: 0,0:23:05.45,0:23:06.12,ED_JP,,0,0,0,,UNHAPPY？
Dialogue: 0,0:23:06.12,0:23:07.28,ED_JP,,0,0,0,,悩める人の子よ
Dialogue: 0,0:23:07.28,0:23:07.74,ED_JP,,0,0,0,,UNLUCKY？
Dialogue: 0,0:23:07.74,0:23:08.83,ED_JP,,0,0,0,,人成らざる者も
Dialogue: 0,0:23:08.83,0:23:09.45,ED_JP,,0,0,0,,BE HAPPY！
Dialogue: 0,0:23:09.45,0:23:10.66,ED_JP,,0,0,0,,弛まず目指せよ
Dialogue: 0,0:23:10.66,0:23:12.08,ED_JP,,0,0,0,,生きているんだし
Dialogue: 0,0:23:12.08,0:23:13.79,ED_JP,,0,0,0,,目を逸らした過去も
Dialogue: 0,0:23:13.79,0:23:15.46,ED_JP,,0,0,0,,退屈な未来も
Dialogue: 0,0:23:15.46,0:23:16.33,ED_JP,,0,0,0,,カウンセリング
Dialogue: 0,0:23:16.33,0:23:17.38,ED_JP,,0,0,0,,やれやれ
Dialogue: 0,0:23:17.38,0:23:18.09,ED_JP,,0,0,0,,古今東西
Dialogue: 0,0:23:18.09,0:23:18.84,ED_JP,,0,0,0,,ピースピース
Dialogue: 0,0:23:18.84,0:23:19.59,ED_JP,,0,0,0,,UNHAPPY？
Dialogue: 0,0:23:20.42,0:23:21.30,ED_JP,,0,0,0,,UNLUCKY？
Dialogue: 0,0:23:22.09,0:23:23.13,ED_JP,,0,0,0,,BE HAPPY！
Dialogue: 0,0:23:23.76,0:23:24.76,ED_JP,,0,0,0,,UNDEAD
Dialogue: 0,0:23:31.72,0:23:32.77,ED_JP,,0,0,0,,カットイン
Dialogue: 0,0:23:32.77,0:23:33.85,ED_JP,,0,0,0,,何だかどうして
Dialogue: 0,0:23:33.85,0:23:35.27,ED_JP,,0,0,0,,未来になんぞ
Dialogue: 0,0:23:35.27,0:23:37.19,ED_JP,,0,0,0,,何の希望もない期待出来ない
Dialogue: 0,0:23:37.19,0:23:39.02,ED_JP,,0,0,0,,ような気がして
Dialogue: 0,0:23:39.02,0:23:40.48,ED_JP,,0,0,0,,もう随分生きている
Dialogue: 0,0:23:40.48,0:23:42.11,ED_JP,,0,0,0,,既視感とテンプレで食傷
Dialogue: 0,0:23:42.11,0:23:45.20,ED_JP,,0,0,0,,素敵な出来事の気配もない
Dialogue: 0,0:23:45.20,0:23:46.16,ED_JP,,0,0,0,,残念
Dialogue: 0,0:23:46.16,0:23:47.28,ED_JP,,0,0,0,,積んだ経験の因果
Dialogue: 0,0:23:47.28,0:23:49.49,ED_JP,,0,0,0,,形骸化された神話と退屈な進化
Dialogue: 0,0:23:49.49,0:23:50.74,ED_JP,,0,0,0,,要は刺激が欲しいんだ
Dialogue: 0,0:23:50.74,0:23:51.37,ED_JP,,0,0,0,,飽きちゃった
Dialogue: 0,0:23:51.37,0:23:52.00,ED_JP,,0,0,0,,慣れちゃった
Dialogue: 0,0:23:52.00,0:23:52.62,ED_JP,,0,0,0,,なんて
Dialogue: 0,0:23:52.62,0:23:54.25,ED_JP,,0,0,0,,整っていくガイダンス
Dialogue: 0,0:23:54.25,0:23:55.75,ED_JP,,0,0,0,,増えるコンプライアンス
Dialogue: 0,0:23:55.75,0:23:57.71,ED_JP,,0,0,0,,蓋されていくみたい
Dialogue: 0,0:23:57.71,0:23:59.34,ED_JP,,0,0,0,,吸い尽くして
Dialogue: 0,0:23:59.34,0:24:01.71,ED_JP,,0,0,0,,あれもこれもどれも
Dialogue: 0,0:24:01.71,0:24:04.01,ED_JP,,0,0,0,,同じ味がする
Dialogue: 0,0:24:04.22,0:24:04.72,ED_JP,,0,0,0,,UNDEAD
Dialogue: 0,0:24:04.72,0:24:06.09,ED_JP,,0,0,0,,死んじゃいない
Dialogue: 0,0:24:06.09,0:24:07.97,ED_JP,,0,0,0,,お前とお前の連鎖
Dialogue: 0,0:24:07.97,0:24:12.02,ED_JP,,0,0,0,,生きていることとは変わり続けることだ
Dialogue: 0,0:24:12.02,0:24:13.81,ED_JP,,0,0,0,,不幸に甘んじて
Dialogue: 0,0:24:13.81,0:24:15.35,ED_JP,,0,0,0,,満足するなよ
Dialogue: 0,0:24:15.35,0:24:19.19,ED_JP,,0,0,0,,幸せになろうとしないなんて卑怯だ
Dialogue: 0,0:24:19.19,0:24:20.65,ED_JP,,0,0,0,,この世この世は
Dialogue: 0,0:24:20.65,0:24:22.11,ED_JP,,0,0,0,,奇怪奇怪ファンタジー
Dialogue: 0,0:24:22.11,0:24:25.24,ED_JP,,0,0,0,,次は鬼が出るか蛇が出るか
Dialogue: 0,0:24:25.24,0:24:28.70,ED_JP,,0,0,0,,出会って遭ってやっと始まる物語
Dialogue: 0,0:24:28.70,0:24:30.70,ED_JP,,0,0,0,,さあ人か化物か
Dialogue: 0,0:24:30.70,0:24:31.41,ED_JP,,0,0,0,,閑話休題
Dialogue: 0,0:24:31.41,0:24:32.20,ED_JP,,0,0,0,,ピースピース
Comment: 0,0:23:05.45,0:23:06.12,ED_CN,,0,0,0,,UNHAPPY？
Dialogue: 0,0:23:06.12,0:23:07.28,ED_CN,,0,0,0,,苦惱的人們
Comment: 0,0:23:07.28,0:23:07.74,ED_CN,,0,0,0,,UNLUCKY？
Dialogue: 0,0:23:07.74,0:23:08.83,ED_CN,,0,0,0,,非人的傢伙們
Comment: 0,0:23:08.83,0:23:09.45,ED_CN,,0,0,0,,BE HAPPY！
Dialogue: 0,0:23:09.45,0:23:10.66,ED_CN,,0,0,0,,不要懈怠向前吧
Dialogue: 0,0:23:10.66,0:23:12.08,ED_CN,,0,0,0,,畢竟還活著
Dialogue: 0,0:23:12.08,0:23:13.79,ED_CN,,0,0,0,,無論是迴避的過去
Dialogue: 0,0:23:13.79,0:23:15.46,ED_CN,,0,0,0,,還是無聊的未來
Dialogue: 0,0:23:15.46,0:23:16.33,ED_CN,,0,0,0,,COUNSELING
Dialogue: 0,0:23:16.33,0:23:17.38,ED_CN,,0,0,0,,真是的
Dialogue: 0,0:23:17.38,0:23:18.09,ED_CN,,0,0,0,,古今中外
Dialogue: 0,0:23:18.09,0:23:18.84,ED_CN,,0,0,0,,PEACE PEACE
Comment: 0,0:23:18.84,0:23:19.59,ED_CN,,0,0,0,,UNHAPPY？
Comment: 0,0:23:20.42,0:23:21.30,ED_CN,,0,0,0,,UNLUCKY？
Comment: 0,0:23:22.09,0:23:23.13,ED_CN,,0,0,0,,BE HAPPY！
Comment: 0,0:23:23.76,0:23:24.76,ED_CN,,0,0,0,,UNDEAD
Dialogue: 0,0:23:31.72,0:23:32.77,ED_CN,,0,0,0,,CUT IN
Dialogue: 0,0:23:32.77,0:23:33.85,ED_CN,,0,0,0,,為甚麼如此呢
Dialogue: 0,0:23:33.85,0:23:35.27,ED_CN,,0,0,0,,對於所謂的未來
Dialogue: 0,0:23:35.27,0:23:37.19,ED_CN,,0,0,0,,難抱任何希望也難有期待
Dialogue: 0,0:23:37.19,0:23:39.02,ED_CN,,0,0,0,,總有這種感覺
Dialogue: 0,0:23:39.02,0:23:40.48,ED_CN,,0,0,0,,已經活了這麼久
Dialogue: 0,0:23:40.48,0:23:42.11,ED_CN,,0,0,0,,既視感和模板化使人厭倦
Dialogue: 0,0:23:42.11,0:23:45.20,ED_CN,,0,0,0,,毫無美好事情的跡象
Dialogue: 0,0:23:45.20,0:23:46.16,ED_CN,,0,0,0,,遺憾
Dialogue: 0,0:23:46.16,0:23:47.28,ED_CN,,0,0,0,,積累過經驗的因果
Dialogue: 0,0:23:47.28,0:23:49.49,ED_CN,,0,0,0,,形式化的神話與乏味的進化
Dialogue: 0,0:23:49.49,0:23:50.74,ED_CN,,0,0,0,,就是想要刺激
Dialogue: 0,0:23:50.74,0:23:51.37,ED_CN,,0,0,0,,受夠了
Dialogue: 0,0:23:51.37,0:23:52.00,ED_CN,,0,0,0,,習慣了
Dialogue: 0,0:23:52.00,0:23:52.62,ED_CN,,0,0,0,,這樣的
Dialogue: 0,0:23:52.62,0:23:54.25,ED_CN,,0,0,0,,越發完善的指引
Dialogue: 0,0:23:54.25,0:23:55.75,ED_CN,,0,0,0,,增多的規範
Dialogue: 0,0:23:55.75,0:23:57.71,ED_CN,,0,0,0,,像要封閉一般
Dialogue: 0,0:23:57.71,0:23:59.34,ED_CN,,0,0,0,,吸盡所有
Dialogue: 0,0:23:59.34,0:24:01.71,ED_CN,,0,0,0,,這一切的一切
Dialogue: 0,0:24:01.71,0:24:04.01,ED_CN,,0,0,0,,都是相同的味道
Comment: 0,0:24:04.22,0:24:04.72,ED_CN,,0,0,0,,UNDEAD
Dialogue: 0,0:24:04.72,0:24:06.09,ED_CN,,0,0,0,,沒有死去
Dialogue: 0,0:24:06.09,0:24:07.97,ED_CN,,0,0,0,,你與你的連鎖
Dialogue: 0,0:24:07.97,0:24:12.02,ED_CN,,0,0,0,,活著便是不斷改變
Dialogue: 0,0:24:12.02,0:24:13.81,ED_CN,,0,0,0,,不要沉溺於不幸中
Dialogue: 0,0:24:13.81,0:24:15.35,ED_CN,,0,0,0,,不要滿足
Dialogue: 0,0:24:15.35,0:24:19.19,ED_CN,,0,0,0,,不去追求幸福便是懦弱
Dialogue: 0,0:24:19.19,0:24:20.65,ED_CN,,0,0,0,,這個世界之中
Dialogue: 0,0:24:20.65,0:24:22.11,ED_CN,,0,0,0,,千奇百怪的幻想
Dialogue: 0,0:24:22.11,0:24:25.24,ED_CN,,0,0,0,,今後的發展難以預料
Dialogue: 0,0:24:25.24,0:24:28.70,ED_CN,,0,0,0,,相遇後終於開始的故事
Dialogue: 0,0:24:28.70,0:24:30.70,ED_CN,,0,0,0,,是人還是怪物
Dialogue: 0,0:24:30.70,0:24:31.41,ED_CN,,0,0,0,,莫提閒話
Dialogue: 0,0:24:31.41,0:24:32.20,ED_CN,,0,0,0,,PEACE PEACE
Comment: 0,0:23:25.13,0:23:27.13,Default,,0,0,0,,
