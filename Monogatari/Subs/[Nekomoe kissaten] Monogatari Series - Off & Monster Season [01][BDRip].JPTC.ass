Dialogue: 0,0:32:00.15,0:32:00.82,ED_JP,,0,0,0,,UNHAPPY？
Dialogue: 0,0:32:00.82,0:32:01.98,ED_JP,,0,0,0,,悩める人の子よ
Dialogue: 0,0:32:01.98,0:32:02.44,ED_JP,,0,0,0,,UNLUCKY？
Dialogue: 0,0:32:02.44,0:32:03.57,ED_JP,,0,0,0,,人成らざる者も
Dialogue: 0,0:32:03.57,0:32:04.15,ED_JP,,0,0,0,,BE HAPPY！
Dialogue: 0,0:32:04.15,0:32:05.36,ED_JP,,0,0,0,,弛まず目指せよ
Dialogue: 0,0:32:05.36,0:32:06.78,ED_JP,,0,0,0,,生きているんだし
Dialogue: 0,0:32:06.78,0:32:08.49,ED_JP,,0,0,0,,目を逸らした過去も
Dialogue: 0,0:32:08.49,0:32:10.16,ED_JP,,0,0,0,,退屈な未来も
Dialogue: 0,0:32:10.16,0:32:11.03,ED_JP,,0,0,0,,カウンセリング
Dialogue: 0,0:32:11.03,0:32:12.08,ED_JP,,0,0,0,,やれやれ
Dialogue: 0,0:32:12.08,0:32:12.79,ED_JP,,0,0,0,,古今東西
Dialogue: 0,0:32:12.79,0:32:13.54,ED_JP,,0,0,0,,ピースピース
Dialogue: 0,0:32:13.54,0:32:14.29,ED_JP,,0,0,0,,UNHAPPY？
Dialogue: 0,0:32:15.12,0:32:16.00,ED_JP,,0,0,0,,UNLUCKY？
Dialogue: 0,0:32:16.79,0:32:17.83,ED_JP,,0,0,0,,BE HAPPY！
Dialogue: 0,0:32:18.46,0:32:19.46,ED_JP,,0,0,0,,UNDEAD
Dialogue: 0,0:32:26.30,0:32:28.47,ED_JP,,0,0,0,,ねえ何だかどうして
Dialogue: 0,0:32:28.47,0:32:30.60,ED_JP,,0,0,0,,戦ってるようなそんな気がするの
Dialogue: 0,0:32:30.60,0:32:31.85,ED_JP,,0,0,0,,触れられない　触れたくもない
Dialogue: 0,0:32:31.85,0:32:33.72,ED_JP,,0,0,0,,過去の自分自分自分自分と
Dialogue: 0,0:32:33.72,0:32:35.18,ED_JP,,0,0,0,,もうとっくに死んでる
Dialogue: 0,0:32:35.18,0:32:36.85,ED_JP,,0,0,0,,透明な亡霊と対決
Dialogue: 0,0:32:36.85,0:32:39.81,ED_JP,,0,0,0,,幼気で痛い記憶の奥
Dialogue: 0,0:32:39.81,0:32:41.81,ED_JP,,0,0,0,,残念？　もう居ないのに
Dialogue: 0,0:32:41.81,0:32:43.61,ED_JP,,0,0,0,,あれ？　そっちが良い？　アイロニーね
Dialogue: 0,0:32:43.61,0:32:46.65,ED_JP,,0,0,0,,透かされているのは現在の自分？
Dialogue: 0,0:32:46.65,0:32:47.45,ED_JP,,0,0,0,,ナンセンス
Dialogue: 0,0:32:47.45,0:32:48.53,ED_JP,,0,0,0,,消えないレッテル
Dialogue: 0,0:32:48.53,0:32:50.11,ED_JP,,0,0,0,,Yes！　要はコンプレックス
Dialogue: 0,0:32:50.11,0:32:52.45,ED_JP,,0,0,0,,取り憑かれているみたい
Dialogue: 0,0:32:52.45,0:32:54.04,ED_JP,,0,0,0,,巻き付いたまま
Dialogue: 0,0:32:54.04,0:32:56.41,ED_JP,,0,0,0,,まだ離れない
Dialogue: 0,0:32:56.41,0:32:58.71,ED_JP,,0,0,0,,在りし日の自分
Dialogue: 0,0:32:58.92,0:32:59.42,ED_JP,,0,0,0,,UNDEAD
Dialogue: 0,0:32:59.42,0:33:00.79,ED_JP,,0,0,0,,死んじゃいない
Dialogue: 0,0:33:00.79,0:33:02.67,ED_JP,,0,0,0,,お前とお前の連鎖
Dialogue: 0,0:33:02.67,0:33:06.71,ED_JP,,0,0,0,,生きていることとは変わり続けることだ
Dialogue: 0,0:33:06.71,0:33:08.51,ED_JP,,0,0,0,,不幸に甘んじて
Dialogue: 0,0:33:08.51,0:33:10.05,ED_JP,,0,0,0,,満足するなよ
Dialogue: 0,0:33:10.05,0:33:13.89,ED_JP,,0,0,0,,幸せになろうとしないなんて卑怯だ
Dialogue: 0,0:33:13.89,0:33:15.35,ED_JP,,0,0,0,,この世この世は
Dialogue: 0,0:33:15.35,0:33:16.81,ED_JP,,0,0,0,,奇怪奇怪ファンタジー
Dialogue: 0,0:33:16.81,0:33:19.94,ED_JP,,0,0,0,,次は鬼が出るか蛇が出るか
Dialogue: 0,0:33:19.94,0:33:23.40,ED_JP,,0,0,0,,出会って遭ってやっと始まる物語
Dialogue: 0,0:33:23.40,0:33:25.40,ED_JP,,0,0,0,,さあ人か化物か
Dialogue: 0,0:33:25.40,0:33:26.11,ED_JP,,0,0,0,,閑話休題
Dialogue: 0,0:33:26.11,0:33:27.24,ED_JP,,0,0,0,,ピースピース
Comment: 0,0:32:00.15,0:32:00.82,ED_CN,,0,0,0,,UNHAPPY？
Dialogue: 0,0:32:00.82,0:32:01.98,ED_CN,,0,0,0,,苦惱的人們
Comment: 0,0:32:01.98,0:32:02.44,ED_CN,,0,0,0,,UNLUCKY？
Dialogue: 0,0:32:02.44,0:32:03.57,ED_CN,,0,0,0,,非人的傢伙們
Comment: 0,0:32:03.57,0:32:04.15,ED_CN,,0,0,0,,BE HAPPY！
Dialogue: 0,0:32:04.15,0:32:05.36,ED_CN,,0,0,0,,不要懈怠向前吧
Dialogue: 0,0:32:05.36,0:32:06.78,ED_CN,,0,0,0,,畢竟還活著
Dialogue: 0,0:32:06.78,0:32:08.49,ED_CN,,0,0,0,,無論是迴避的過去
Dialogue: 0,0:32:08.49,0:32:10.16,ED_CN,,0,0,0,,還是無聊的未來
Dialogue: 0,0:32:10.16,0:32:11.03,ED_CN,,0,0,0,,COUNSELING
Dialogue: 0,0:32:11.03,0:32:12.08,ED_CN,,0,0,0,,真是的
Dialogue: 0,0:32:12.08,0:32:12.79,ED_CN,,0,0,0,,古今中外
Dialogue: 0,0:32:12.79,0:32:13.54,ED_CN,,0,0,0,,PEACE PEACE
Comment: 0,0:32:13.54,0:32:14.29,ED_CN,,0,0,0,,UNHAPPY？
Comment: 0,0:32:15.12,0:32:16.00,ED_CN,,0,0,0,,UNLUCKY？
Comment: 0,0:32:16.79,0:32:17.83,ED_CN,,0,0,0,,BE HAPPY！
Comment: 0,0:32:18.46,0:32:19.46,ED_CN,,0,0,0,,UNDEAD
Dialogue: 0,0:32:26.30,0:32:28.47,ED_CN,,0,0,0,,為甚麼如此呢
Dialogue: 0,0:32:28.47,0:32:30.60,ED_CN,,0,0,0,,總有一種在戰鬥的感覺
Dialogue: 0,0:32:30.60,0:32:31.85,ED_CN,,0,0,0,,無法觸碰 也不願去觸碰
Dialogue: 0,0:32:31.85,0:32:33.72,ED_CN,,0,0,0,,過去的自己自己自己自己
Dialogue: 0,0:32:33.72,0:32:35.18,ED_CN,,0,0,0,,與早已經死去的
Dialogue: 0,0:32:35.18,0:32:36.85,ED_CN,,0,0,0,,透明的亡靈對決
Dialogue: 0,0:32:36.85,0:32:39.81,ED_CN,,0,0,0,,年幼而痛苦的記憶深處
Dialogue: 0,0:32:39.81,0:32:41.81,ED_CN,,0,0,0,,遺憾嗎？早已不存在了
Dialogue: 0,0:32:41.81,0:32:43.61,ED_CN,,0,0,0,,咦？那樣更好？真是諷刺
Dialogue: 0,0:32:43.61,0:32:46.65,ED_CN,,0,0,0,,被看透的是現在的自己？
Dialogue: 0,0:32:46.65,0:32:47.45,ED_CN,,0,0,0,,NONSENSE
Dialogue: 0,0:32:47.45,0:32:48.53,ED_CN,,0,0,0,,無法消除的標籤
Dialogue: 0,0:32:48.53,0:32:50.11,ED_CN,,0,0,0,,Yes！歸根結底是自卑
Dialogue: 0,0:32:50.11,0:32:52.45,ED_CN,,0,0,0,,像是被附身了一般
Dialogue: 0,0:32:52.45,0:32:54.04,ED_CN,,0,0,0,,糾纏著不放
Dialogue: 0,0:32:54.04,0:32:56.41,ED_CN,,0,0,0,,依然沒有離開
Dialogue: 0,0:32:56.41,0:32:58.71,ED_CN,,0,0,0,,曾經的自己
Comment: 0,0:32:58.92,0:32:59.42,ED_CN,,0,0,0,,UNDEAD
Dialogue: 0,0:32:59.42,0:33:00.79,ED_CN,,0,0,0,,沒有死去
Dialogue: 0,0:33:00.79,0:33:02.67,ED_CN,,0,0,0,,你與你的連鎖
Dialogue: 0,0:33:02.67,0:33:06.71,ED_CN,,0,0,0,,活著便是不斷改變
Dialogue: 0,0:33:06.71,0:33:08.51,ED_CN,,0,0,0,,不要沉溺於不幸中
Dialogue: 0,0:33:08.51,0:33:10.05,ED_CN,,0,0,0,,不要滿足
Dialogue: 0,0:33:10.05,0:33:13.89,ED_CN,,0,0,0,,不去追求幸福便是懦弱
Dialogue: 0,0:33:13.89,0:33:15.35,ED_CN,,0,0,0,,這個世界之中
Dialogue: 0,0:33:15.35,0:33:16.81,ED_CN,,0,0,0,,千奇百怪的幻想
Dialogue: 0,0:33:16.81,0:33:19.94,ED_CN,,0,0,0,,今後的發展難以預料
Dialogue: 0,0:33:19.94,0:33:23.40,ED_CN,,0,0,0,,相遇後終於開始的故事
Dialogue: 0,0:33:23.40,0:33:25.40,ED_CN,,0,0,0,,是人還是怪物
Dialogue: 0,0:33:25.40,0:33:26.11,ED_CN,,0,0,0,,莫提閒話
Dialogue: 0,0:33:26.11,0:33:27.24,ED_CN,,0,0,0,,PEACE PEACE
Comment: 0,0:23:25.13,0:23:27.13,Default,,0,0,0,,
Dialogue: 0,0:01:28.19,0:01:30.19,Oroka_OPJP,,0,0,0,,あいすくりいむの温度で
Dialogue: 0,0:01:30.19,0:01:32.20,Oroka_OPJP,,0,0,0,,1！2！3！3！
Dialogue: 0,0:01:40.12,0:01:43.83,Oroka_OPJP,,0,0,0,,切り離した　僕の欠片を
Dialogue: 0,0:01:43.83,0:01:47.76,Oroka_OPJP,,0,0,0,,すぷうんで　掬ってみたのです
Dialogue: 0,0:01:47.96,0:01:51.79,Oroka_OPJP,,0,0,0,,癒えないまま　のみこんだ言葉
Dialogue: 0,0:01:52.01,0:01:55.85,Oroka_OPJP,,0,0,0,,ひんやり　すべりおちてく痛み
Dialogue: 0,0:01:56.26,0:01:57.72,Oroka_OPJP,,0,0,0,,永遠にアイス
Dialogue: 0,0:01:57.72,0:02:00.24,Oroka_OPJP,,0,0,0,,口の中で　今　とける間に
Dialogue: 0,0:02:00.24,0:02:01.75,Oroka_OPJP,,0,0,0,,君だけをアイス
Dialogue: 0,0:02:01.75,0:02:04.21,Oroka_OPJP,,0,0,0,,ひとつだけ　なんて　選べない
Dialogue: 0,0:02:04.21,0:02:08.33,Oroka_OPJP,,0,0,0,,反比例する　乙女心が
Dialogue: 0,0:02:08.33,0:02:10.33,Oroka_OPJP,,0,0,0,,おわかりか？
Dialogue: 0,0:02:10.33,0:02:11.95,Oroka_OPJP,,0,0,0,,おかわりだ！
Dialogue: 0,0:02:12.31,0:02:15.93,Oroka_OPJP,,0,0,0,,全部　なかったことにして
Dialogue: 0,0:02:16.05,0:02:19.84,Oroka_OPJP,,0,0,0,,全部　たべたい　もう一度
Dialogue: 0,0:02:19.84,0:02:23.86,Oroka_OPJP,,0,0,0,,たとえ　ちょっと　まちがえちゃっても
Dialogue: 0,0:02:23.86,0:02:26.38,Oroka_OPJP,,0,0,0,,やりなおせば　いいじゃん
Dialogue: 0,0:02:26.38,0:02:28.02,Oroka_OPJP,,0,0,0,,undo！　∞！
Dialogue: 0,0:02:28.17,0:02:32.12,Oroka_OPJP,,0,0,0,,あと　ひとくち　もう　ひとくち
Dialogue: 0,0:02:32.12,0:02:36.09,Oroka_OPJP,,0,0,0,,甘い誘惑　罪かさねて
Dialogue: 0,0:02:36.09,0:02:37.97,Oroka_OPJP,,0,0,0,,苺　一重
Dialogue: 0,0:02:37.97,0:02:39.47,Oroka_OPJP,,0,0,0,,二重　三重
Dialogue: 0,0:02:39.47,0:02:42.55,Oroka_OPJP,,0,0,0,,un! deux! trois!
Dialogue: 0,0:02:44.43,0:02:46.49,Oroka_OPJP,,0,0,0,,あい　すくりいむな角度で
Dialogue: 0,0:02:46.49,0:02:48.31,Oroka_OPJP,,0,0,0,,¡¿一大すとれす?!
Dialogue: 0,0:02:48.47,0:02:50.52,Oroka_OPJP,,0,0,0,,あいす　くりいむの温度で
Dialogue: 0,0:02:50.52,0:02:52.48,Oroka_OPJP,,0,0,0,,1！2！3！3！
Comment: 0,0:23:27.13,0:23:27.14,Default,,0,0,0,,
Dialogue: 0,0:01:28.19,0:01:30.19,Oroka_OPTC,,0,0,0,,以冰淇淋的溫度
Comment: 0,0:01:30.19,0:01:32.20,Oroka_OPTC,,0,0,0,,1！2！3！3！
Dialogue: 0,0:01:40.12,0:01:43.83,Oroka_OPTC,,0,0,0,,從身上剝離的那片殘缺
Dialogue: 0,0:01:43.83,0:01:47.76,Oroka_OPTC,,0,0,0,,用勺子輕輕舀起
Dialogue: 0,0:01:47.96,0:01:51.79,Oroka_OPTC,,0,0,0,,未曾治癒 嚥下無法說出口的話
Dialogue: 0,0:01:52.01,0:01:55.85,Oroka_OPTC,,0,0,0,,帶著寒意的痛苦 靜靜滑落
Dialogue: 0,0:01:56.26,0:01:57.72,Oroka_OPTC,,0,0,0,,永遠的冰淇淋
Dialogue: 0,0:01:57.72,0:02:00.24,Oroka_OPTC,,0,0,0,,此刻於口中融化之時
Dialogue: 0,0:02:00.24,0:02:01.75,Oroka_OPTC,,0,0,0,,僅屬於你的冰淇淋
Dialogue: 0,0:02:01.75,0:02:04.21,Oroka_OPTC,,0,0,0,,如何只挑選一種
Dialogue: 0,0:02:04.21,0:02:08.33,Oroka_OPTC,,0,0,0,,反比例變化的少女心情
Dialogue: 0,0:02:08.33,0:02:10.33,Oroka_OPTC,,0,0,0,,是否明白？
Dialogue: 0,0:02:10.33,0:02:11.95,Oroka_OPTC,,0,0,0,,再來一盒！
Dialogue: 0,0:02:12.31,0:02:15.93,Oroka_OPTC,,0,0,0,,將一切抹去 彷彿從未發生
Dialogue: 0,0:02:16.05,0:02:19.84,Oroka_OPTC,,0,0,0,,想要重新品嘗那滋味
Dialogue: 0,0:02:19.84,0:02:23.86,Oroka_OPTC,,0,0,0,,即使稍有差錯又如何
Dialogue: 0,0:02:23.86,0:02:26.38,Oroka_OPTC,,0,0,0,,只需重新來過便好
Dialogue: 0,0:02:26.38,0:02:28.02,Oroka_OPTC,,0,0,0,,復原！無限！
Dialogue: 0,0:02:28.17,0:02:32.12,Oroka_OPTC,,0,0,0,,再來一口 就一口
Dialogue: 0,0:02:32.12,0:02:36.09,Oroka_OPTC,,0,0,0,,甜蜜的誘惑 累積的罪過
Dialogue: 0,0:02:36.09,0:02:37.97,Oroka_OPTC,,0,0,0,,草莓 一層
Dialogue: 0,0:02:37.97,0:02:39.47,Oroka_OPTC,,0,0,0,,兩層 三層
